region             = "us-ashburn-1" # must be your tenancy's home region
oci_config_profile = "DEFAULT"
compartment_ocid   = "ocid1.compartment.oc1..replace-with-your-compartment-ocid"
tenancy_ocid       = "ocid1.tenancy.oc1..replace-with-your-tenancy-ocid"
name_prefix        = "hermes"

# Your SSH public key, e.g.: ssh_public_key = file("~/.ssh/id_ed25519.pub")
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# From `terraform apply` in this stack (vault_id / vault_key_id outputs),
# then `scripts/bootstrap-secrets.sh --compartment-id ... --vault-id ... --key-id ...`
dashboard_basic_auth_secret_ocid = "ocid1.vaultsecret.oc1..replace-after-running-bootstrap-secrets"

# Only these CIDRs may reach TCP/22 on the instance. Never set 0.0.0.0/0.
ssh_allowed_cidrs = [
  "203.0.113.4/32", # example: your home/office IP
]

freeform_tags = {
  "environment" = "prod"
}
