region             = "us-ashburn-1" # must be your tenancy's home region
oci_config_profile = "DEFAULT"
compartment_ocid   = "ocid1.compartment.oc1..replace-with-your-compartment-ocid"
tenancy_ocid       = "ocid1.tenancy.oc1..replace-with-your-tenancy-ocid"
name_prefix        = "infra"

# -----------------------------------------------------------------------------
# Module Deployment Toggles
# Set true/false to deploy either Hermes, Piston, or both.
# -----------------------------------------------------------------------------
deploy_hermes = true
deploy_piston = false

# SSH Access
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
ssh_allowed_cidrs = [
  "203.0.113.4/32", # example: your home/office IP
]

# -----------------------------------------------------------------------------
# Hermes Workload Configuration
# -----------------------------------------------------------------------------
hermes_instance_ocpus       = 2
hermes_instance_memory_gb   = 12
hermes_boot_volume_size_gb  = 50
hermes_data_volume_size_gb  = 100
hermes_ingress_ports        = [9119]

dashboard_basic_auth_secret_ocid = "ocid1.vaultsecret.oc1..replace-after-running-bootstrap-secrets"
tailscale_authkey_secret_ocid    = "ocid1.vaultsecret.oc1..replace-after-running-bootstrap-secrets"
age_recipient_public_key         = "age1replace-with-your-age-public-key"
alert_email                      = "you@example.com"

# -----------------------------------------------------------------------------
# Piston Workload Configuration
# -----------------------------------------------------------------------------
piston_instance_ocpus       = 2
piston_instance_memory_gb   = 12
piston_boot_volume_size_gb  = 50
piston_api_port             = 2000
piston_ingress_ports        = [2000]
piston_allowed_cidrs        = ["203.0.113.4/32"] # or empty to default to ssh_allowed_cidrs / 0.0.0.0/0
piston_tailscale_authkey    = ""                 # optional Tailscale authkey for Piston

freeform_tags = {
  "environment" = "prod"
}
