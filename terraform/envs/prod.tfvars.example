region             = "us-ashburn-1" # must be your tenancy's home region
oci_config_profile = "DEFAULT"
compartment_ocid   = "ocid1.compartment.oc1..replace-with-your-compartment-ocid"
tenancy_ocid       = "ocid1.tenancy.oc1..replace-with-your-tenancy-ocid"
name_prefix        = "hermes"

# Optional: SSH public key for direct public access. Omit/leave blank if using Tailscale SSH exclusively.
# ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# From `terraform apply` in this stack (vault_id / vault_key_id outputs),
# then `scripts/bootstrap-secrets.sh --compartment-id ... --vault-id ... --key-id ...`
dashboard_basic_auth_secret_ocid = "ocid1.vaultsecret.oc1..replace-after-running-bootstrap-secrets"
tailscale_authkey_secret_ocid    = "ocid1.vaultsecret.oc1..replace-after-running-bootstrap-secrets"

# Optional — omit to leave the stdio GitHub MCP without a PAT (gh CLI /
# github/* skills still work once you `gh auth login` manually over SSH).
# github_pat_secret_ocid = "ocid1.vaultsecret.oc1..from-bootstrap-secrets---github-pat"

# Optional — defaults rotate openrouter -> nvidia_nim -> mistral every 4h.
# Replace the nvidia_nim/mistral model names with ones your account can use.
# provider_rotation = [
#   "openrouter:openrouter/auto",
#   "nvidia_nim:nvidia/llama-3.1-nemotron-70b-instruct",
#   "mistral:mistral-large-latest",
# ]

# Generate with: age-keygen -o key.txt   (keep key.txt off the VM, in a password manager)
age_recipient_public_key = "age1replace-with-your-age-public-key"

# You'll get a confirmation email from OCI Notifications after apply — click it.
alert_email = "you@example.com"

# Optional — off-cloud git mirror target. Empty (default) disables it.
# github_mirror_owner = "your-github-username-or-org"

# Optional: Direct public SSH CIDR allowlist. Leave empty ([]) if using Tailscale SSH.
ssh_allowed_cidrs = []

freeform_tags = {
  "environment" = "prod"
}
